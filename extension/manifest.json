{
  "manifest_version": 3,
  "name": "Etsy Search Scraper",
  "version": "1.0.0",
  "description": "Bulk-extract product listings from Etsy search result pages: multi-keyword, pagination, JSON-LD + DOM parsing, JSON/CSV/Excel export.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Etsy Search Scraper",
    "default_popup": "src/ui/app.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "offscreen",
    "scripting",
    "tabs",
    "alarms"
  ],
  "optional_permissions": [
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "optional_host_permissions": [
    "https://api.etsy.com/*"
  ],
  "host_permissions": [
    "https://www.etsy.com/*"
  ]
}
